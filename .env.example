# ---------------------------------------------------------------------------
# Copy to .env.local for development. On Vercel, set these in Project
# Settings -> Environment Variables.
#
# Every NEXT_PUBLIC_* value is INLINED AT BUILD TIME. Changing one in the
# Vercel dashboard does nothing until you redeploy.
# ---------------------------------------------------------------------------

# --- Backend API ---
# Accepts either a bare origin or the /graphql endpoint; the trailing
# /graphql is stripped. Used by the browser only to decide whether to show
# the "no API configured" banner — all real traffic goes through this app's
# own /api/* routes, which attach the auth cookie server-side.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com/graphql

# Server-only equivalent, preferred by the /api/* route handlers when set.
# Worth setting separately so the API origin isn't shipped to the browser.
# Falls back to NEXT_PUBLIC_API_URL.
API_URL=https://your-api.onrender.com

# --- Map ---
# Get one free at https://account.mapbox.com/access-tokens/
# WITHOUT THIS the map silently degrades to a plain list of structures —
# StructureMap renders StructureGridFallback instead of Mapbox GL. An empty
# string counts as missing.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# NOT USED — do not add these back.
#
# NEXTAUTH_SECRET / NEXTAUTH_URL appear in some older deploys, but NextAuth
# is not a dependency of this app. Auth is httpOnly cookies issued by
# src/app/api/auth/*, signed by the backend's JWT_SECRET. Setting the
# NEXTAUTH_* vars has no effect and misleads whoever reads the config next.
#
# NEXT_PUBLIC_WS_URL is likewise unused: the alert inbox polls on a 30s
# interval (see useAlerts) and there is no WebSocket gateway yet.
# ---------------------------------------------------------------------------
